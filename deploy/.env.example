# Server setup environment variables (docker compose --env-file deploy/.env)
# In production the backend WILL NOT START with a weak/missing JWT_SECRET or ADMIN_PASSWORD.

# Domain name → automatic HTTPS. ":80" only for LAN testing (HTTP; release APKs need https).
SITE_ADDRESS=signage.example.com

NODE_ENV=production
# openssl rand -hex 32
JWT_SECRET=
# Access-token lifetime; panel sessions are kept alive by refresh tokens (REFRESH_TTL_DAYS, default 30).
JWT_EXPIRES_IN=15m

# Superadmin created on first start (password of at least 10 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Panel address: used for the QR pairing link on devices, CORS and links in emails
PANEL_URL=https://signage.example.com
CORS_ORIGIN=https://signage.example.com

# Time zone (backup hour and logs; container default is UTC)
TZ=Europe/Istanbul

# Daily backup hour (in TZ) and number of backups to keep; directory: /data/backups
BACKUP_HOUR=3
BACKUP_KEEP=14

# Email (invitations, password reset). Without SMTP_HOST nothing is sent: the links are
# written to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Signage <no-reply@example.com>

# Media library. Files are stored on the /data volume (MEDIA_DIR=/data/media) by default.
# For S3-compatible storage (AWS S3, Cloudflare R2, MinIO) set MEDIA_STORAGE=s3 and:
# MEDIA_STORAGE=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Optional error reporting
SENTRY_DSN=
