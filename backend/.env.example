# Backend environment variables
NODE_ENV=development
PORT=3001

# Database — a single SQLite file (no Postgres/Redis needed)
DB_FILE=signage.db

# JWT — at least 32 characters are required in production (openssl rand -hex 32);
# when empty, development falls back to `dev-secret`.
JWT_SECRET=
# Access-token lifetime. The panel keeps sessions alive with refresh tokens.
JWT_EXPIRES_IN=15m
# REFRESH_TTL_DAYS=30

# Bootstrap admin — this user is made superadmin at startup (created with the password if missing).
# Use it to regain access after a lost/wrong account.
# In production the password needs at least 10 characters and must not be an example value (otherwise the server refuses to start).
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123

# CORS (panel address)
CORS_ORIGIN=http://localhost:3000

# Panel address — used for the QR pairing link shown on devices (PANEL_URL/devices?pair=CODE)
# and for links in emails. If empty the device guesses (backend :3001 → panel :3000).
PANEL_URL=

# Real client IP behind a reverse proxy (Caddy/Nginx), needed for rate limiting
# TRUST_PROXY=1

# Email for invitations and password reset. Without SMTP_HOST nothing is sent:
# the content (including links) is written to the server log.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Signage <no-reply@example.com>

# Media library (uploads). Default: local disk under MEDIA_DIR.
# MEDIA_DIR=data/media
# Uploaded video length is verified with ffprobe (part of ffmpeg). Without it videos are
# rejected, unless you accept unverified videos for development:
# FFPROBE_PATH=/usr/bin/ffprobe
# MEDIA_ALLOW_UNVERIFIED_VIDEO=true
# Hard ceiling for one upload while receiving (the per-organization limit is checked too)
# MEDIA_HARD_MAX_MB=1024
# S3-compatible storage instead of local disk (AWS S3, Cloudflare R2, MinIO):
# MEDIA_STORAGE=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Daily SQLite backup (disabled when empty); the hour is local time
# BACKUP_DIR=backups
# BACKUP_HOUR=3
# BACKUP_KEEP=14

# Optional error reporting (Sentry is not started when empty)
# SENTRY_DSN=
